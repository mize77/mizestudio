{
  // XquiX Studio (the application) — served as static assets from the repo root.
  //
  // Named "xquix-app", deliberately NOT "xquix-studio": the auth Worker is
  // called "xquixstudio", and two names a hyphen apart invite editing the wrong
  // one. The three pieces read clearly now:
  //     xquixstudio  -> auth service        (auth.xquix.com)
  //     xquix-app    -> the application     (app.xquix.com)
  //     xquix-web    -> the public website  (xquix.com)
  //
  // No "main" entry point: the Studio is a self-contained index.html, so
  // Cloudflare serves it straight from the edge with no Worker in the request
  // path. Nothing is built — the repo IS the site — so there is no build
  // command and the assets directory is the repo root.
  //
  // Because the root is the assets directory, .assetsignore next to this file
  // keeps repository plumbing from being published.
  "name": "xquix-app",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "."
  }
}

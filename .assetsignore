# Everything in this repo is published to the web except the following.
# Same syntax as .gitignore. Cloudflare excludes nothing by default, so
# repository plumbing has to be named here or it becomes publicly fetchable.
.git
.gitignore
.assetsignore
wrangler.jsonc
.DS_Store
Archive

# Working documents and tooling. Nothing in the app fetches these at runtime
# (checked), and without these lines they are publicly readable at
# app.xquix.com/<filename> -- these are internal engineering notes.
*.md
*.sh
_inlined_*
.promote-backup
